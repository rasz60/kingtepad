PORT=8080
# 배포 시 Caddy 뒤에 두려면 127.0.0.1 (API 와 픽셀 오피스 프록시 모두 이 주소로 뜬다)
HOST=0.0.0.0
# 웹 앱 주소 (CORS 허용). 여러 개면 쉼표로 구분
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# 알림 스케줄러 (사용자 요청 없이 1분마다 실행되므로 service_role 키 필요). 서버 밖으로 절대 노출 금지.
# 비워두면 스케줄러가 꺼지고, 알림은 웹을 열었을 때만 생성된다.
SUPABASE_SERVICE_ROLE_KEY=

# 웹 푸시 키: npx web-push generate-vapid-keys 로 생성. 공개키는 apps/web/.env 의 VITE_VAPID_PUBLIC_KEY 에도 넣는다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── 에이전트 모니터 (구 pixel-agent-monitor) ──
# 픽셀 오피스(pixel-agents) 프록시 포트. 웹의 VITE_MONITOR_OFFICE_URL 이 이 포트(또는 Caddy 가 넘겨주는 포트)를 가리켜야 한다
MONITOR_OFFICE_PORT=8081
# 0 이면 pixel-agents 를 띄우지 않는다 (상태 로그·알림만 동작)
MONITOR_PIXEL_AGENTS=1
# 배치 작업이 POST /monitor/status 할 때 X-Monitor-Token 헤더로 보낼 값 (jobs/.env 와 같게).
# 비우면 같은 서버(127.0.0.1)에서 직접 보낸 요청만 받는다
MONITOR_INGEST_TOKEN=
# 세션 쿠키 서명 키. 비우면 실행할 때마다 새로 만든다 (재시작 시 탭이 자동으로 다시 로그인)
MONITOR_SESSION_SECRET=
# 픽셀 오피스에 표시될 프로젝트 폴더 (비우면 API 실행 폴더)
PIXEL_AGENTS_PROJECT_DIR=
