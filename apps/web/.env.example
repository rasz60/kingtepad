# Supabase 프로젝트 > Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Oracle Cloud 백엔드 (리포트·알림·에이전트 모니터). 비워두면 관련 기능 비활성
# 개발: http://localhost:8080 / 배포(Caddy): https://kingtepad.duckdns.org/api
VITE_API_URL=

# 에이전트 모니터 픽셀 오피스 주소 (API 의 MONITOR_OFFICE_PORT 프록시). 비우면 접속한 호스트의 8081 포트
# 배포 예: https://kingtepad.duckdns.org:8443
VITE_MONITOR_OFFICE_URL=

# 웹 푸시 공개키 (apps/api/.env 의 VAPID_PUBLIC_KEY 와 같은 값). 비워두면 푸시 구독 비활성
VITE_VAPID_PUBLIC_KEY=
