# Supabase 프로젝트 > Settings > API (ae:p 포털과 같은 값이어야 로그인이 공유된다)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Oracle Cloud 백엔드 (리포트·알림·에이전트 모니터). 비워두면 관련 기능 비활성
# 개발: http://localhost:8080 / 배포(Caddy): https://ae2p.duckdns.org/api/diary
VITE_API_URL=

# 에이전트 모니터 픽셀 오피스 주소 (API 의 MONITOR_OFFICE_PORT 프록시). 비우면 접속한 호스트의 8081 포트
# 배포 예: https://ae2p.duckdns.org:8443
VITE_MONITOR_OFFICE_URL=
