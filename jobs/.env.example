# 배치 작업 설정. jobs/.env 로 복사해서 쓴다 (절대 커밋 금지)

# 에이전트 모니터 (kingtepad API)
MONITOR_STATUS_URL=http://127.0.0.1:8080/monitor/status
# apps/api/.env 의 MONITOR_INGEST_TOKEN 과 같은 값 (API 에서 비웠으면 생략)
MONITOR_INGEST_TOKEN=

# KIS(한국투자증권) Developer API (run_stocks.py). https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌면 주석 해제
# KIS_REST_DOMAIN=https://openapivts.koreainvestment.com:29443

# 나라장터 감시 공고번호 (watch_openg.py). CLI --bid-no 가 있으면 그게 우선
# BID_NO=R26BK01630788
# BID_ORD=000

# KTX 잔여석 감시 (watch_ktx.py · scripts/ktx-watch.sh). CLI 옵션이 있으면 그게 우선, 비우면 코드 기본값
# KTX_DEP=나주
# KTX_ARR=용산
# KTX_DATE=20261127
# 조회 기준 시각 HHmmss (이 시각 이후 열차가 조회된다. 찾는 열차 출발 직전으로)
# KTX_TIME=172000
# KTX_TRAIN_NO=466
# KTX_ADULTS=1
# 조회 간격(초), 최소 30
# KTX_INTERVAL=60

# 카카오톡 '나에게 보내기' (kakao_notify.py). Kakao Developers 앱 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 로그인 > 보안 > Client Secret 을 켰을 때만
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 등록한 값 (kakao_auth.py 최초 발급에만 쓴다)
KAKAO_REDIRECT_URI=http://localhost:8765/kakao
# 메시지 버튼을 누르면 열 주소. 앱 > 플랫폼 > Web 사이트 도메인에 등록한 도메인이어야 한다
KAKAO_LINK_URL=https://ae2p.duckdns.org/diary/monitor
