# 배치 작업 설정. jobs/.env 로 복사해서 쓴다 (절대 커밋 금지)

# 에이전트 모니터 (kingtepad API)
MONITOR_STATUS_URL=http://127.0.0.1:8080/monitor/status
# apps/api/.env 의 MONITOR_INGEST_TOKEN 과 같은 값 (API 에서 비웠으면 생략)
MONITOR_INGEST_TOKEN=

# KIS(한국투자증권) Developer API (run_stocks.py). https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌면 주석 해제
# KIS_REST_DOMAIN=https://openapivts.koreainvestment.com:29443

# 나라장터 감시 공고번호 (watch_openg.py). CLI --bid-no 가 있으면 그게 우선
# BID_NO=R26BK01630788
# BID_ORD=000
